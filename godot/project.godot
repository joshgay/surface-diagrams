; Surface Diagrams Studio seed. Runtime validation is tracked in STATE.md.
config_version=5

[application]
config/name="Surface Diagrams Studio"
run/main_scene="res://scenes/studio.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.95, 0.97, 0.95, 1)

[gui]
theme/default_font_multichannel_signed_distance_field=true
